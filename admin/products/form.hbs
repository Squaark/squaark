<div class="page-header">
  <div class="page-header__left">
    <a href="/admin/products" class="page-back">← Products</a>
    <h1 class="page-title">{{#if product}}{{product.title}}{{else}}New product{{/if}}</h1>
  </div>
  {{#if product}}
  <form method="POST" action="/admin/products/{{product.id}}/delete" onsubmit="return confirm('Delete this product?')">
    {{csrf_field}}
    <button type="submit" class="btn-link btn-link--danger btn-link--sm">Delete</button>
  </form>
  {{/if}}
</div>

{{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}
{{#if saved}}<div class="alert alert-success">Saved.</div>{{/if}}
{{#if created}}<div class="alert alert-success">Product created.</div>{{/if}}

<div class="grid-form">
  <!-- Main form -->
  <div class="stack">
    <form id="main-form" method="POST" action="/admin/products/{{#if product}}{{product.id}}{{else}}new{{/if}}">
      {{csrf_field}}
      <input type="hidden" name="variant_ids" value="{{#each variants}}{{this.id}}{{#unless @last}},{{/unless}}{{/each}}">

      <div class="card--no-overflow card-body stack-sm">
        <h2 class="font-semibold">Details</h2>
        <div>
          <label class="form-label">Title <span class="form-required">*</span></label>
          <input type="text" name="title" value="{{product.title}}" required class="form-input">
        </div>
        <div>
          <label class="form-label">Slug <span class="form-required">*</span></label>
          <div class="form-prefix">
            <span class="form-prefix-text">/products/</span>
            <input type="text" name="slug" value="{{product.slug}}" required class="form-input flex-1">
          </div>
        </div>
        <div>
          <label class="form-label">Description</label>
          <textarea name="description" rows="5" class="form-textarea">{{product.description}}</textarea>
        </div>
        <div>
          <label class="form-label">Vendor</label>
          <input type="text" name="vendor" value="{{product.vendor}}" class="form-input">
        </div>
        <div>
          <label class="form-label">Tags <span class="form-optional">(comma separated)</span></label>
          <input type="text" name="tags_text" value="{{product.tags_text}}" class="form-input">
        </div>
      </div>

      <!-- SEO -->
      <div class="card--no-overflow card-body stack-sm mt-4">
        <h2 class="font-semibold">SEO</h2>
        <div>
          <label class="form-label">Meta title <span class="form-optional">— defaults to product title. 50–60 chars recommended.</span></label>
          <input type="text" name="seo_title" value="{{product.seo_title}}" class="form-input" maxlength="120" placeholder="{{product.title}}">
        </div>
        <div>
          <label class="form-label">Meta description <span class="form-optional">— 150–160 chars recommended.</span></label>
          <textarea name="seo_description" rows="3" class="form-textarea" maxlength="320" placeholder="Describe this product for search engines…">{{product.seo_description}}</textarea>
        </div>
      </div>

      <!-- Variants -->
      <div class="card--no-overflow card-body stack-sm mt-4">
        <h2 class="font-semibold">{{#if variants.length}}Variants{{else}}Pricing & Inventory{{/if}}</h2>

        {{#if variants.length}}
        {{#each variants}}
        <div style="border:1px solid #f3f4f6;border-radius:0.5rem;padding:1rem;" class="stack-xs">
          <p class="text-sm font-medium">Variant: {{this.title}}</p>
          <div class="form-row form-row--3">
            <div>
              <label class="form-label-xs">Title</label>
              <input type="text" name="variant_title_{{this.id}}" value="{{this.title}}" class="form-input">
            </div>
            <div>
              <label class="form-label-xs">Price (£)</label>
              <input type="number" step="0.01" min="0" name="price_{{this.id}}" value="{{money_pence this.price}}" class="form-input">
            </div>
            <div>
              <label class="form-label-xs">Compare at (£)</label>
              <input type="number" step="0.01" min="0" name="compare_at_price_{{this.id}}" value="{{money_pence this.compare_at_price}}" class="form-input">
            </div>
            <div>
              <label class="form-label-xs">SKU</label>
              <input type="text" name="sku_{{this.id}}" value="{{this.sku}}" class="form-input">
            </div>
            <div>
              <label class="form-label-xs">Inventory</label>
              <input type="number" min="0" name="inventory_quantity_{{this.id}}" value="{{this.inventory_quantity}}" class="form-input">
            </div>
          </div>
        </div>
        {{/each}}
        {{else}}
        <div class="form-row form-row--3">
          <div>
            <label class="form-label-xs">Variant title</label>
            <input type="text" name="variant_title" value="Default" class="form-input">
          </div>
          <div>
            <label class="form-label-xs">Price (£)</label>
            <input type="number" step="0.01" min="0" name="price" value="0.00" class="form-input">
          </div>
          <div>
            <label class="form-label-xs">Compare at (£)</label>
            <input type="number" step="0.01" min="0" name="compare_at_price" class="form-input">
          </div>
          <div>
            <label class="form-label-xs">SKU</label>
            <input type="text" name="sku" class="form-input">
          </div>
          <div>
            <label class="form-label-xs">Inventory</label>
            <input type="number" min="0" name="inventory_quantity" value="0" class="form-input">
          </div>
        </div>
        {{/if}}
      </div>

      <div class="card--no-overflow card-body stack-sm mt-4"
        x-data="{ items: [], q: '', results: [],
          add(p){ if(!this.items.some(i=>i.id===p.id)) this.items.push(p); this.q=''; this.results=[]; },
          remove(i){ this.items.splice(i,1); },
          async search(){ if(this.q.trim().length<2){ this.results=[]; return; } const res = await fetch('/admin/products/search?q='+encodeURIComponent(this.q.trim())); const list = await res.json(); this.results = list.filter(p => p.id !== '{{product.id}}' && !this.items.some(i=>i.id===p.id)); } }"
        x-init="items = JSON.parse($refs.seed.textContent || '[]')">
        <script type="application/json" x-ref="seed">{{{relatedJson}}}</script>
        <label class="form-label">Related products <span class="form-optional">— shown on the product page. Leave empty to pick automatically (same collection).</span></label>
        <input type="hidden" name="related_ids" :value="items.map(i=>i.id).join(',')">

        <div style="position:relative;">
          <input type="text" x-model="q" @input.debounce.300ms="search()" placeholder="Search products to add…" class="form-input" autocomplete="off">
          <ul x-show="results.length" x-cloak style="position:absolute;z-index:20;left:0;right:0;margin-top:0.25rem;background:#fff;border:1px solid #e5e7eb;border-radius:0.5rem;box-shadow:0 4px 12px rgba(0,0,0,.08);max-height:14rem;overflow:auto;list-style:none;padding:0.25rem;">
            <template x-for="p in results" :key="p.id">
              <li><button type="button" @click="add(p)" class="dropdown-item" style="width:100%;text-align:left;padding:0.4rem 0.6rem;background:none;border:none;cursor:pointer;border-radius:0.375rem;" x-text="'+ ' + p.title"></button></li>
            </template>
          </ul>
        </div>

        <ul x-show="items.length" x-cloak style="display:flex;flex-wrap:wrap;gap:0.4rem;list-style:none;padding:0;margin:0.25rem 0 0;">
          <template x-for="(p, i) in items" :key="p.id">
            <li style="display:inline-flex;align-items:center;gap:0.4rem;background:#f3f4f6;border-radius:9999px;padding:0.2rem 0.6rem;font-size:0.8rem;">
              <span x-text="p.title"></span>
              <button type="button" @click="remove(i)" aria-label="Remove" style="background:none;border:none;cursor:pointer;color:#6b7280;font-size:1rem;line-height:1;">&times;</button>
            </li>
          </template>
        </ul>
        <p class="form-hint" x-show="!items.length" x-cloak>None chosen — related products will be picked automatically.</p>
      </div>

      <div class="mt-4" style="display:flex;justify-content:flex-end">
        <button type="submit" class="btn btn-primary">
          {{#if product}}Save changes{{else}}Create product{{/if}}
        </button>
      </div>
    </form>

    <!-- Digital file -->
    <div id="digital-file-card" class="card--no-overflow card-body" {{#unless (eq product.is_digital 1)}}style="display:none"{{/unless}}>
      <h2 class="font-semibold mb-4">Digital file</h2>
      {{#if product}}
        {{#if digitalFile}}
        <div class="row mb-3" style="align-items:center;gap:0.75rem;">
          <div style="flex:1;min-width:0;">
            <p class="text-sm font-medium" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{digitalFile.original_name}}</p>
            <p class="text-xs text-muted">{{digitalFile.size}} bytes</p>
          </div>
          <form method="POST" action="/admin/products/{{product.id}}/file/delete" onsubmit="return confirm('Remove this file?')">
            {{csrf_field}}
            <button type="submit" class="btn-link btn-link--danger btn-link--sm">Remove</button>
          </form>
        </div>
        {{else}}
        <p class="text-sm text-muted mb-3">No file attached. Upload a file to make this product downloadable.</p>
        {{/if}}
        <form method="POST" action="/admin/products/{{product.id}}/file?_csrf={{@root.csrfToken}}" enctype="multipart/form-data">
          {{csrf_field}}
          <div class="row mt-1">
            <input type="file" name="file" required class="form-file flex-1">
            <button type="submit" class="btn btn-primary btn-sm">{{#if digitalFile}}Replace{{else}}Upload{{/if}}</button>
          </div>
        </form>
      {{else}}
        <p class="text-sm text-muted">Save the product first, then come back to attach a downloadable file.</p>
      {{/if}}
    </div>

    <!-- Images -->
    <div class="card--no-overflow card-body">
      <h2 class="font-semibold mb-4">Images</h2>
      {{#if product}}
        {{#if uploaded}}
        <div class="alert alert-success">Image uploaded.</div>
        {{/if}}
        <div class="row mb-4" style="flex-wrap:wrap;gap:0.75rem;">
          {{#each images}}
          <div style="position:relative;">
            <img src="{{this.thumbnail}}" alt="{{this.alt}}" style="width:5rem;height:5rem;object-fit:cover;border-radius:0.5rem;border:1px solid #e5e7eb;">
            <form method="POST" action="/admin/products/{{../product.id}}/images/{{this.id}}/delete"
              style="position:absolute;top:0.25rem;right:0.25rem;">
              {{csrf_field}}
              <button type="submit" title="Remove" class="btn-link btn-link--danger" style="background:#fff;border:1px solid #e5e7eb;border-radius:50%;width:1.25rem;height:1.25rem;display:flex;align-items:center;justify-content:center;font-size:0.75rem;">×</button>
            </form>
          </div>
          {{/each}}
        </div>
        <form method="POST" action="/admin/products/{{product.id}}/images?_csrf={{@root.csrfToken}}" enctype="multipart/form-data">
          {{csrf_field}}
          <label class="form-label">Upload image</label>
          <div class="row mt-1">
            <input type="file" name="file" accept="image/*" required class="form-file flex-1">
            <button type="submit" class="btn btn-primary btn-sm">Upload</button>
          </div>
        </form>
      {{else}}
        <p class="text-sm text-muted">Save the product first, then come back to upload images.</p>
      {{/if}}
    </div>
  </div>

  <!-- Sidebar -->
  <div class="stack-sm">
    <div class="card--no-overflow card-body">
      <h2 class="font-semibold mb-3">Status</h2>
      <label class="form-check">
        <input type="checkbox" name="published" value="1" {{#if (eq product.published 1)}}checked{{/if}} form="main-form">
        Published
      </label>
    </div>
    <div class="card--no-overflow card-body stack-sm">
      <h2 class="font-semibold text-sm">Shipping &amp; Tax</h2>
      <label class="form-check">
        <input type="checkbox" name="is_digital" value="1" {{#if (eq product.is_digital 1)}}checked{{/if}} form="main-form"
               id="is-digital-toggle" onchange="document.getElementById('digital-file-card').style.display=this.checked?'':'none'">
        Digital product
      </label>
      <p class="text-xs text-muted">Digital products are delivered by download link. No shipping is charged when the entire cart is digital.</p>
      <label class="form-check">
        <input type="checkbox" name="free_shipping" value="1" {{#if (eq product.free_shipping 1)}}checked{{/if}} form="main-form">
        Free shipping
      </label>
      <p class="text-xs text-muted">When checked, this product bypasses zone shipping rates. If every item in the cart has free shipping, the customer is charged £0.</p>
      <label class="form-check">
        <input type="checkbox" name="requires_slot" value="1" {{#if (eq product.requires_slot 1)}}checked{{/if}} form="main-form">
        Needs a booked delivery/collection date
      </label>
      <p class="text-xs text-muted">When on, an order containing this product must choose a shipping/collection option that offers date &amp; time slots, and book one at checkout.</p>
      <div>
        <label class="form-label-xs">Tax band</label>
        <select name="tax_band_id" form="main-form" class="form-select">
          <option value="">No tax (untaxed)</option>
          {{#each taxBands}}
            <option value="{{this.id}}" {{#if (eq this.id ../product.tax_band_id)}}selected{{/if}}>
              {{this.name}}{{#if this.rate}} ({{this.rate}}%){{/if}}
            </option>
          {{/each}}
        </select>
        {{#unless taxBands.length}}
          <p class="text-xs text-muted">No tax bands yet. <a href="/admin/tax/new" target="_blank">Create one</a> first.</p>
        {{/unless}}
      </div>
    </div>
    {{#if product}}
    <div class="card--no-overflow card-body text-xs text-muted stack-xs">
      <p>Created {{date_short product.created_at}}</p>
      <p>Updated {{date_short product.updated_at}}</p>
    </div>
    {{/if}}
  </div>
</div>
