<div class="page-header">
  <div class="page-header__left">
    <a href="/admin/shipping" class="page-back">← Shipping</a>
    <h1 class="page-title">{{#if zone}}{{zone.name}}{{else}}New shipping zone{{/if}}</h1>
  </div>
  {{#if zone}}
  <form method="POST" action="/admin/shipping/{{zone.id}}/delete" onsubmit="return confirm('Delete this zone and all its rates?')">
    <button type="submit" class="btn-link btn-link--danger btn-link--sm">Delete zone</button>
  </form>
  {{/if}}
</div>

{{#if saved}}<div class="alert alert-success">Saved.</div>{{/if}}
{{#if created}}<div class="alert alert-success">Zone created.</div>{{/if}}

<div class="grid-form">
  <div class="stack">

    <!-- Zone details -->
    <form method="POST" action="/admin/shipping/{{#if zone}}{{zone.id}}{{else}}new{{/if}}">
      <div class="card--no-overflow card-body stack-sm">
        <h2 class="font-semibold">Zone details</h2>
        <div>
          <label class="form-label">Zone name <span class="form-required">*</span></label>
          <input type="text" name="name" value="{{zone.name}}" required class="form-input" placeholder="e.g. United Kingdom, Europe, Rest of world">
        </div>
        <div>
          <label class="form-label">Countries</label>
          <p class="text-xs text-muted" style="margin-bottom:0.75rem;">Tick all countries this zone applies to. Use "Rest of world" as a catch-all fallback.</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));gap:0.375rem;">
            {{#each countries}}
            <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;cursor:pointer;">
              <input type="checkbox" name="countries[]" value="{{this.code}}"
                {{#if (isSelected this.code ../selected)}}checked{{/if}}
                style="width:1rem;height:1rem;accent-color:var(--admin-accent);">
              {{this.name}} <span style="color:#9ca3af;">({{this.code}})</span>
            </label>
            {{/each}}
          </div>
        </div>
        <div style="margin-top:0.5rem;">
          <button type="submit" class="btn btn-primary">
            {{#if zone}}Save zone{{else}}Create zone{{/if}}
          </button>
        </div>
      </div>
    </form>

    {{#if zone}}
    <!-- Rates -->
    <div class="card--no-overflow card-body stack-sm">
      <h2 class="font-semibold">Shipping rates</h2>

      {{#if rates.length}}
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Charge</th>
            <th>Threshold</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each rates}}
          <tr>
            <td class="font-medium">{{this.name}}</td>
            <td class="text-sm text-muted">
              {{#if (eq this.rate_type 'flat')}}Flat rate{{/if}}
              {{#if (eq this.rate_type 'free')}}Free{{/if}}
              {{#if (eq this.rate_type 'free_over')}}Free over threshold{{/if}}
            </td>
            <td class="text-sm">
              {{#if (eq this.rate_type 'free')}}—{{/if}}
              {{#if (eq this.rate_type 'flat')}}{{pence this.amount}}{{/if}}
              {{#if (eq this.rate_type 'free_over')}}{{pence this.amount}} (below threshold){{/if}}
            </td>
            <td class="text-sm">
              {{#if (eq this.rate_type 'free_over')}}{{pence this.min_order_amount}}{{else}}—{{/if}}
            </td>
            <td style="text-align:right;">
              <form method="POST" action="/admin/shipping/{{../zone.id}}/rates/{{this.id}}/delete"
                    onsubmit="return confirm('Delete this rate?')" style="display:inline;">
                <button type="submit" class="btn-link btn-link--danger btn-link--xs">Remove</button>
              </form>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}

      <!-- Add rate form -->
      <form method="POST" action="/admin/shipping/{{zone.id}}/rates"
            x-data="{ rateType: 'flat' }" style="border-top:1px solid #f3f4f6;padding-top:1rem;margin-top:0.5rem;">
        <p class="text-sm font-medium" style="margin-bottom:0.75rem;">Add a rate</p>
        <div class="form-row form-row--3">
          <div>
            <label class="form-label-xs">Rate name</label>
            <input type="text" name="name" placeholder="e.g. Standard Delivery" class="form-input" required>
          </div>
          <div>
            <label class="form-label-xs">Type</label>
            <select name="rate_type" class="form-select" x-model="rateType">
              <option value="flat">Flat rate</option>
              <option value="free">Always free</option>
              <option value="free_over">Free over threshold</option>
            </select>
          </div>
          <div x-show="rateType !== 'free'">
            <label class="form-label-xs">
              <span x-text="rateType === 'free_over' ? 'Charge below threshold' : 'Amount'"></span>
            </label>
            <input type="number" name="amount" min="0" step="0.01" placeholder="0.00" class="form-input">
          </div>
        </div>
        <div x-show="rateType === 'free_over'" style="margin-top:0.75rem;" x-cloak>
          <label class="form-label-xs">Free shipping threshold (order subtotal)</label>
          <input type="number" name="min_order_amount" min="0" step="0.01" placeholder="e.g. 50.00" class="form-input" style="max-width:12rem;">
        </div>
        <div style="margin-top:0.75rem;">
          <button type="submit" class="btn btn-secondary btn-sm">Add rate</button>
        </div>
      </form>
    </div>
    {{/if}}

  </div>

  <!-- Sidebar -->
  <div>
    <div class="card--no-overflow card-body text-xs text-muted stack-xs">
      <p><strong>Flat rate</strong> — always charges the same amount.</p>
      <p><strong>Always free</strong> — £0 shipping for this zone.</p>
      <p><strong>Free over threshold</strong> — free when the cart subtotal meets the threshold, otherwise charges the flat amount.</p>
      <p style="margin-top:0.5rem;">If a customer's country matches multiple zones, the first matching zone is used. Use "Rest of world (*)" as a catch-all fallback zone.</p>
    </div>
  </div>
</div>

<script>
// Register isSelected helper
</script>
