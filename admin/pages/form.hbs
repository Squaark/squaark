<div class="page-header">
  <div class="page-header__left">
    <a href="/admin/pages" class="page-back">← Pages</a>
    <h1 class="page-title">{{#if page}}{{page.title}}{{else}}New page{{/if}}</h1>
  </div>
  {{#if page}}
  <form method="POST" action="/admin/pages/{{page.id}}/delete" onsubmit="return confirm('Delete this page?')">
    {{csrf_field}}
    <button type="submit" class="btn-link btn-link--danger btn-link--sm">Delete</button>
  </form>
  {{/if}}
</div>

{{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}
{{#if saved}}<div class="alert alert-success">Saved.</div>{{/if}}
{{#if created}}<div class="alert alert-success">Page created.</div>{{/if}}
{{#if published}}<div class="alert alert-success">Published — your changes are live.</div>{{/if}}
{{#if draftSaved}}<div class="alert alert-success">Draft saved — not live until you publish.</div>{{/if}}
{{#if discarded}}<div class="alert alert-success">Draft discarded; reverted to the published version.</div>{{/if}}

<form method="POST" action="/admin/pages/{{#if page}}{{page.id}}{{else}}new{{/if}}">
  {{csrf_field}}

  {{#> section-builder}}
    <!-- Publish bar — always visible, keeps Save/Publish reachable -->
    <div class="card--no-overflow card-body editor-publish stack-sm">
      {{#if hasDraft}}<p class="editor-draft-badge">● Unpublished section changes</p>{{/if}}
      <label class="form-check" style="margin:0;">
        <input type="checkbox" name="status" value="published" {{#if (eq page.status 'published')}}checked{{/if}}>
        Page visible (published)
      </label>
      <label class="form-check" style="margin:0;">
        <input type="checkbox" name="use_as_homepage" value="1" {{#if isHomepage}}checked{{/if}}>
        Use as home page
      </label>
      {{#if page}}
        <div class="row" style="gap:0.5rem;">
          <button type="submit" name="action" value="draft" class="btn btn-secondary btn-sm flex-1">Save draft</button>
          <button type="submit" name="action" value="publish" class="btn btn-primary btn-sm flex-1">Publish</button>
        </div>
        {{#if hasDraft}}
        <button type="submit" name="action" value="discard" formnovalidate
          onclick="return confirm('Discard the draft and revert to the published version?')"
          class="btn-link btn-link--danger btn-link--xs">Discard draft</button>
        {{/if}}
        <a href="/{{page.slug}}" target="_blank" class="text-xs text-muted">View published page ↗</a>
      {{else}}
        <button type="submit" name="action" value="publish" class="btn btn-primary btn-sm btn-block">Create page</button>
      {{/if}}
    </div>

    <!-- Page details (collapsible) -->
    <details class="editor-panel" open>
      <summary>Page details</summary>
      <div class="editor-panel__body stack-sm">
        <div>
          <label class="form-label">Title <span class="form-required">*</span></label>
          <input type="text" name="title" value="{{page.title}}" required class="form-input">
        </div>
        <div>
          <label class="form-label">Slug <span class="form-required">*</span></label>
          <div class="form-prefix">
            <span class="form-prefix-text">/</span>
            <input type="text" name="slug" value="{{page.slug}}" required class="form-input flex-1">
          </div>
        </div>
        <div>
          <label class="form-label">Excerpt <span class="form-optional">— search snippet</span></label>
          <textarea name="excerpt" rows="2" class="form-textarea">{{page.excerpt}}</textarea>
        </div>
      </div>
    </details>

    <!-- SEO (collapsible) -->
    <details class="editor-panel">
      <summary>SEO</summary>
      <div class="editor-panel__body stack-sm">
        <div>
          <label class="form-label">Meta title <span class="form-optional">50–60 chars</span></label>
          <input type="text" name="seo_title" value="{{page.seo_title}}" class="form-input" maxlength="120" placeholder="{{page.title}}">
        </div>
        <div>
          <label class="form-label">Meta description <span class="form-optional">150–160 chars</span></label>
          <textarea name="seo_description" rows="3" class="form-textarea" maxlength="320" placeholder="Describe this page for search engines…">{{page.seo_description}}</textarea>
        </div>
      </div>
    </details>
  {{/section-builder}}

</form>
