<div class="page-header">
  <h1 class="page-title">Customers</h1>
  <span class="text-muted text-sm">{{total}} total</span>
</div>

{{#if deleted}}<div class="alert alert-success">Customer deleted.</div>{{/if}}

<div class="card">
  {{#if customers.length}}
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Status</th>
        <th class="right">Orders</th>
        <th class="right">Spent</th>
        <th>Joined</th>
        <th>Group</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each customers}}
      <tr>
        <td class="font-medium">{{this.first_name}} {{this.last_name}}</td>
        <td class="text-muted">{{this.email}}</td>
        <td>
          {{#if (eq this.email_verified 1)}}
          <span class="badge badge-green">Verified</span>
          {{else}}
          <span class="badge badge-gray">Unverified</span>
          {{/if}}
        </td>
        <td class="right">{{this.order_count}}</td>
        <td class="right">{{pence this.total_spent}}</td>
        <td class="text-muted text-xs">{{date_short this.created_at}}</td>
        <td>
          <form method="POST" action="/admin/customers/{{this.id}}/group">
            {{csrf_field}}
            <select name="group_id" class="form-select" style="padding:0.2rem 0.4rem;font-size:0.8rem;" onchange="this.form.submit()">
              <option value="">— none —</option>
              {{#each ../groups}}
                <option value="{{this.id}}" {{#if (eq this.id ../group_id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </form>
        </td>
        <td class="right">
          <form method="POST" action="/admin/customers/{{this.id}}/delete"
            onsubmit="return confirm('Delete {{this.email}}? Their account is removed; past orders are kept.')">
            {{csrf_field}}
            <button type="submit" class="btn-link btn-link--danger btn-link--xs">Delete</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <div class="empty-state">
    <p>No customers yet. Accounts created at checkout or via the storefront sign-up will appear here.</p>
  </div>
  {{/if}}
</div>

<div class="card card-body mt-4">
  <h2 class="font-semibold mb-1">Customer groups</h2>
  <p class="text-sm text-muted" style="margin-bottom:0.75rem;">Group customers (e.g. Trade, Wholesale). Group pricing and pay-on-account terms build on these.</p>
  {{#if groups.length}}
  <ul style="list-style:none;padding:0;margin:0 0 1rem;display:flex;flex-direction:column;gap:0.35rem;max-width:24rem;">
    {{#each groups}}
    <li style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
      <span class="text-sm">{{this.name}}</span>
      <form method="POST" action="/admin/customer-groups/{{this.id}}/delete"
        onsubmit="return confirm('Delete the “{{this.name}}” group? Customers in it become ungrouped.')">
        {{csrf_field}}
        <button type="submit" class="btn-link btn-link--danger btn-link--xs">Delete</button>
      </form>
    </li>
    {{/each}}
  </ul>
  {{/if}}
  <form method="POST" action="/admin/customer-groups" class="row" style="gap:0.5rem;max-width:24rem;">
    {{csrf_field}}
    <input type="text" name="name" placeholder="New group name (e.g. Trade)" class="form-input flex-1" required>
    <button type="submit" class="btn btn-secondary btn-sm">Add group</button>
  </form>
</div>

{{#if (gt totalPages 1)}}
<div class="admin-pagination mt-4">
  {{#if (gt page 1)}}
  <a href="?page={{subtract page 1}}">← Previous</a>
  {{else}}<span></span>{{/if}}
  <span class="admin-pagination__info">Page {{page}} of {{totalPages}}</span>
  {{#if (lt page totalPages)}}
  <a href="?page={{add page 1}}">Next →</a>
  {{else}}<span></span>{{/if}}
</div>
{{/if}}
