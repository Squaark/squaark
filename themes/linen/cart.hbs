{{> header}}

<div class="container cart-page">
  <h1 class="cart-page__title">Your {{store.cartLabel}}</h1>

  {{#if outOfStock}}
    <div class="auth-error" style="margin-bottom:1.5rem;">One or more items in your {{store.cartLabel}} are no longer in stock in the quantity requested. Please adjust the quantities and try again.</div>
  {{/if}}

  {{#if cart.empty}}
    <div style="text-align:center;padding:6rem 0;">
      <p style="color:#9ca3af;font-size:1.125rem;margin-bottom:1rem;">Your {{store.cartLabel}} is empty.</p>
      <a href="/collections/all" class="btn btn-primary" style="display:inline-block;">Continue Shopping</a>
    </div>
  {{else}}
    <div class="cart-layout">

      <!-- Items -->
      <div>
        {{> cart-contents}}
      </div>

      <!-- Summary -->
      <div>
        <div class="cart-summary">
          <h2 class="cart-summary__title">Order summary</h2>

          <div class="summary-rows">
            <div class="summary-row">
              <span>Subtotal ({{pluralize cart.itemCount "item" "items"}})</span>
              <span>{{money cart.subtotal}}</span>
            </div>
            {{#if cart.discountAmount}}
              <div class="summary-row summary-row--discount">
                <span>Discount ({{cart.discountCode}})</span>
                <span>-{{money cart.discountAmount}}</span>
              </div>
            {{/if}}
            <div class="summary-row summary-row--muted">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>
          </div>

          <div class="summary-total">
            <span>Total</span>
            <span>{{money cart.total}}</span>
          </div>

          {{#if cart.discountCode}}
            <div class="discount-row" style="justify-content:space-between;align-items:center;">
              <span style="font-size:0.875rem;color:#374151;">Code <strong>{{cart.discountCode}}</strong> applied</span>
              <form method="POST" action="/{{store.cartSlug}}/discount/remove" style="display:inline;">
                {{csrf_field}}
                <button type="submit" style="font-size:0.8rem;color:#9ca3af;background:none;border:none;cursor:pointer;text-decoration:underline;">Remove</button>
              </form>
            </div>
          {{else}}
            <form method="POST" action="/{{store.cartSlug}}/discount" class="discount-row">
              {{csrf_field}}
              <input type="text" name="discount" placeholder="Discount code" class="store-input" style="flex:1;">
              <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
            </form>
          {{/if}}
          {{#if discountError}}
            <p style="font-size:0.8rem;color:#b91c1c;margin-top:0.4rem;">{{discountError}}</p>
          {{/if}}

          <a href="{{cart.checkoutUrl}}"
             class="btn btn-block"
             style="margin-top:1rem;background:var(--color-accent);color:#fff;display:flex;justify-content:center;">
            Proceed to Checkout
          </a>

          <a href="/collections/all" style="display:block;text-align:center;font-size:0.75rem;color:#9ca3af;margin-top:0.75rem;">
            ← Continue Shopping
          </a>
        </div>
      </div>
    </div>
  {{/if}}
</div>

{{> footer}}
