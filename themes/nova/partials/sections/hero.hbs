<section class="section-hero{{#if src}} section-hero--image{{/if}}{{#if (eq align 'center')}} section-hero--center{{/if}}"{{#if (or src (or bgColor textColor))}} style="{{#if src}}background-image:url('{{src}}');{{/if}}{{#if bgColor}}--hero-bg:{{bgColor}};{{/if}}{{#if textColor}}--hero-text:{{textColor}};{{/if}}"{{/if}}{{#if src}} role="img" aria-label="{{alt}}"{{/if}}>
  <div class="section-hero__inner">
    {{#if heading}}<h2 class="section-hero__heading">{{heading}}</h2>{{/if}}
    {{#if subheading}}<p class="section-hero__subheading">{{subheading}}</p>{{/if}}
    {{#if buttonLabel}}<a href="{{buttonUrl}}" class="section-hero__btn">{{buttonLabel}}</a>{{/if}}
  </div>
</section>
