<section class="section-map"{{#if (or bgColor textColor)}} style="{{#if bgColor}}--section-bg:{{bgColor}};{{/if}}{{#if textColor}}--section-text:{{textColor}};{{/if}}"{{/if}}>
  <div class="container">
    {{#if heading}}<h2 class="section-map__title">{{heading}}</h2>{{/if}}
    <div class="section-map__grid">
      <div class="section-map__info">
        {{#if address}}<p class="section-map__address">{{address}}</p>{{/if}}
        {{#if phone}}<p class="section-map__line"><a href="tel:{{phone}}">{{phone}}</a></p>{{/if}}
        {{#if email}}<p class="section-map__line"><a href="mailto:{{email}}">{{email}}</a></p>{{/if}}
      </div>
      {{#if (and showMap address)}}
      <div class="section-map__frame">
        <iframe src="{{map_embed address}}" title="Map" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      {{/if}}
    </div>
  </div>
</section>
